prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib
doxygen_tag=${prefix}/doc/log.tag
lsst_build_requires=boost_test python3 pybind11

Name: lsst_log
Description: LSST Science Pipelines logging framework
Version: @VERSION@
Requires: liblog4cxx
Cflags: -I${includedir}
Libs: -L${libdir} -llog
